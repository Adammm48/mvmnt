node_modules/
.DS_Store
*.log

# Env / secrets — never commit. See .env.example for the shape.
.env
.env.*
!.env.example

# Supabase local stack
supabase/.branches/
supabase/.temp/

# Expo / React Native
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/dist/

# Vite / admin build output
apps/admin/dist/
apps/*/.vite/

# Generated types are committed on purpose (they are reviewed in PRs),
# so packages/shared/src/database.types.ts is NOT ignored.

# Expo web export used only for bundle verification
apps/mobile/.expo/

# Intermediate frames for the README animation; the GIF itself is committed
docs/screenshots/.frames/

# Claude Code's per-machine settings. Records which commands were approved on
# this laptop and nothing about the project — noise in a shared repo, and it
# accumulates local session tokens as a side effect.
.claude/settings.local.json

# Throwaway browser-verification scripts, run from the repo root so
# playwright resolves. Never part of the project.
*.tmp.mjs
