{
  "name": "mvmnt",
  "private": true,
  "version": "0.1.0",
  "description": "MVMNT run club \u2014 mobile app, admin console and Supabase backend",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && bash scripts/seed-media.sh",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:test": "bash scripts/test-db.sh",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run db:test",
    "seed:media": "bash scripts/seed-media.sh",
    "docs:screenshots": "node scripts/screenshots.mjs",
    "docs:gif": "node scripts/capture-checkin-gif.mjs && python3 scripts/frames-to-gif.py",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test:e2e": "node tests/e2e/visible-outcomes.mjs",
    "check:reachable": "node scripts/check-reachable.mjs",
    "ios:sim": "bash scripts/run-ios.sh",
    "ios:phone": "bash scripts/run-iphone.sh"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "supabase": "^2.109.1"
  }
}