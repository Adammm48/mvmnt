# Copy to .env and fill in. Never commit .env.
#
# Local values come from `supabase start` output. Production values come from the
# Supabase dashboard (Project Settings > API).

# --- Shared / client-safe -------------------------------------------------
# The anon key is designed to be shipped in client code. It is only safe because
# Row Level Security is enabled on every table — see supabase/migrations/0009_rls.sql.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Expo requires the EXPO_PUBLIC_ prefix for anything readable in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Vite requires the VITE_ prefix for anything readable in the admin bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Server only — NEVER put these in an app or admin bundle --------------
# Bypasses RLS entirely. Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Development conveniences --------------------------------------------
# Lets the mobile app supply hand-typed coordinates instead of a real GPS fix,
# so geofenced check-in can be tested without driving to the meeting point.
# Has no effect in release builds — see apps/mobile/src/lib/location.ts.
EXPO_PUBLIC_DEV_FAKE_LOCATION=false
